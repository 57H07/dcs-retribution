{
  "$comment": "Single source of the design tokens (GFX-01). Edit this file, then run `python -m qt_ui.design_tokens` to regenerate resources/stylesheets/generated/*.qss and client/src/theme/tokens.css. 'base' tokens are shared by every variant; each variant must define exactly the same tokens. A token path such as color.bg.canvas becomes the CSS variable --color-bg-canvas, which is also the name used by the QSS template (resources/stylesheets/theme.qss.template).",
  "defaultVariant": "dark",
  "base": {
    "font": {
      "family": "Inter",
      "family-fallback": "\"Segoe UI\", Arial, sans-serif",
      "size": {
        "xs": "8px",
        "sm": "10px",
        "md": "12px",
        "lg": "14px",
        "xl": "16px",
        "title": "24px"
      },
      "weight": {
        "regular": "400",
        "medium": "500",
        "semibold": "600",
        "bold": "700"
      }
    },
    "space": {
      "xxs": "2px",
      "xs": "4px",
      "sm": "6px",
      "md": "10px",
      "lg": "16px",
      "xl": "24px"
    },
    "radius": {
      "sm": "2px",
      "md": "4px",
      "lg": "8px"
    },
    "color": {
      "task": {
        "air": "#445299",
        "intercept": "#7752bc",
        "strike": "#ab2244",
        "dead": "#cc8844",
        "sead": "#aa7744"
